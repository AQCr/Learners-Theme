<section class="featured-collection">
  <div class="container">
    <h2 class="section-title">🌟 Featured Collection</h2>
    <p class="section-subtitle">Explore our handpicked bestsellers</p>

    <div class="product-grid">
      {% for product in collections['frontpage'].products limit:4 %}
        <div class="product-card">
          <div class="image-wrapper">
            <img src="{{ product.featured_image | img_url: '500x' }}" alt="{{ product.title }}">
          </div>
          <h3 class="product-title">{{ product.title }}</h3>
          <p class="product-price">{{ product.price | money }}</p>
          <a href="{{ product.url }}" class="shop-btn">Shop Now</a>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
.featured-collection {
  background: linear-gradient(135deg, #fafafa, #f3f3f3);
  padding: 80px 20px;
  text-align: center;
  font-family: 'Poppins', sans-serif;
}

.featured-collection .container {
  max-width: 1200px;
  margin: 0 auto;
}

.section-title {
  font-size: 2.5rem;
  font-weight: 700;
  color: #222;
  margin-bottom: 10px;
}

.section-subtitle {
  color: #666;
  font-size: 1rem;
  margin-bottom: 40px;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 30px;
}

.product-card {
  background: #fff;
  border-radius: 16px;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  overflow: hidden;
}

.product-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
}

.image-wrapper {
  width: 100%;
  height: 280px;
  overflow: hidden;
}

.image-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.product-card:hover img {
  transform: scale(1.1);
}

.product-title {
  font-size: 1.1rem;
  font-weight: 600;
  color: #222;
  margin: 15px 0 5px;
}

.product-price {
  color: #0c7b93;
  font-weight: 500;
  margin-bottom: 15px;
}

.shop-btn {
  display: inline-block;
  background: #0c7b93;
  color: #fff;
  text-decoration: none;
  padding: 10px 25px;
  border-radius: 25px;
  font-weight: 500;
  transition: background 0.3s ease, transform 0.3s ease;
}

.shop-btn:hover {
  background: #095e70;
  transform: scale(1.05);
}
</style>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}